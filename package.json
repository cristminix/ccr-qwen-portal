{
  "name": "@musistudio/claude-code-router",
  "version": "1.0.43",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "bin": {
    "ccr2": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node dist/cli.js start",
    "dev": "npx tsx watch src/cli.ts start",
    "release": "npm run build && npm publish"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "musistudio",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@musistudio/llms": "file:./llms",
    "openurl": "^1.1.1",
    "pino-rotating-file-stream": "^0.0.2",
    "tiktoken": "^1.0.21",
    "@anthropic-ai/sdk": "^0.54.0",
    "@fastify/cors": "^11.0.1",
    "@google/genai": "^1.7.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "google-auth-library": "^10.1.0",
    "json5": "^2.2.3",
    "jsonrepair": "^3.13.0",
    "openai": "^5.6.0",
    "undici": "^7.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "fastify": "^5.4.0",
    "shx": "^0.4.0",
    "tsx": "^4.20.5",
    "@types/chai": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^17.0.4",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "chai": "^5.2.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.30.0",
    "nodemon": "^3.1.10",
    "sinon": "^21.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "publishConfig": {
    "ignore": [
      "!build/",
      "src/",
      "screenshots/"
    ]
  }
}
